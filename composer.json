{
    "name": "exercise/hfm-signup",
    "description": "A registration and login exercise built with PHP and SQLite.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "serve": "php -S 127.0.0.1:8000 -t public public/index.php",
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true
    }
}

